# Signal Station Environment Configuration
# Copy to .env and adjust for your local deployment

# Application Environment (development | production)
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Security and Demo Mode
# Local demo mode is only permitted when APP_ENV=development and binds 127.0.0.1.
# Startup strictly refuses demo mode if APP_ENV=production.
DEMO_MODE=true
SECRET_KEY=change-this-in-production-to-a-secure-random-string

# SQLite Database Path
DATABASE_PATH=data/signal_station.db

# OIDC / Keycloak SSO Configuration
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/signal-station
OIDC_CLIENT_ID=signal-station-client
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=signal-station-api
OIDC_JWKS_URL=http://127.0.0.1:8080/realms/signal-station/protocol/openid-connect/certs

# LLM Advisory Adapter Configuration
# LLM_API_KEY is the sole secret credential variable.
# Leave blank for deterministic offline evaluation and execution.
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
